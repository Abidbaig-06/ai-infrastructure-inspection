# CivicPulse Backend & Supabase Configuration
PORT=5000

# To connect to live Supabase, enter your Project URL and Anon/Service Role Key below:
SUPABASE_URL=
SUPABASE_KEY=

# NVIDIA NIM vision model (build.nvidia.com)
# Single key: NVIDIA_API_KEY=nvapi-...
# Or a pool (round-robin + failover): NVIDIA_API_KEYS=nvapi-...,nvapi-...
NVIDIA_API_KEYS=
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
